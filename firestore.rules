rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && (request.auth.token.email == 'growlocalcreative@gmail.com' || request.auth.uid == 'bQkiEyF4dSVHrK9xvFtKNXuTE2p2');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().size() == 2 &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.createdAt is string;
    }

    function isValidAuditLead(data) {
      return data.keys().hasAll([
               'email',
               'name',
               'phone',
               'hasWebsite',
               'websiteUrl',
               'businessName',
               'businessType',
               'town',
               'recommendedSpecialty',
               'topIssues',
               'summary',
               'createdAt'
             ]) &&
             data.keys().hasOnly([
               'email',
               'name',
               'phone',
               'hasWebsite',
               'websiteUrl',
               'businessName',
               'businessType',
               'town',
               'recommendedSpecialty',
               'topIssues',
               'summary',
               'createdAt'
             ]) &&
             data.email is string &&
             data.email.size() >= 5 &&
             data.email.size() <= 256 &&
             data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             data.name is string &&
             data.name.size() <= 120 &&
             data.phone is string &&
             data.phone.size() <= 40 &&
             data.hasWebsite is bool &&
             data.websiteUrl is string &&
             data.websiteUrl.size() <= 500 &&
             data.businessName is string &&
             data.businessName.size() <= 140 &&
             data.businessType is string &&
             data.businessType.size() >= 1 &&
             data.businessType.size() <= 80 &&
             data.town is string &&
             data.town.size() >= 1 &&
             data.town.size() <= 80 &&
             data.recommendedSpecialty is string &&
             data.recommendedSpecialty.size() <= 80 &&
             data.topIssues is list &&
             data.topIssues.size() <= 5 &&
             data.summary is string &&
             data.summary.size() <= 800 &&
             data.createdAt is string &&
             data.createdAt.size() >= 10 &&
             data.createdAt.size() <= 64;
    }

    // Site Settings
    match /site_settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Content
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow create: if isValidSubscriber(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Website & Google Readiness Audit Leads
    match /audit_leads/{leadId} {
      allow create: if isValidId(leadId) && isValidAuditLead(incoming());
      allow read, update, delete: if isAdmin();
    }
  }
}
