{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global configuration for the agency site",
      "type": "object",
      "properties": {
        "agencyName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "footerDescription": { "type": "string" },
        "sectionOrder": { "type": "array" },
        "hiddenSections": { "type": "array" },
        "newsletter": { "type": "object" },
        "socialLinks": { "type": "array" }
      }
    },
    "Content": {
      "title": "Page Content",
      "description": "Generic content document for page sections",
      "type": "object",
      "properties": {
        "heading": { "type": "string" },
        "subheading": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "textColor": { "type": "string" }
      }
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "AuditLead": {
      "title": "Audit Lead",
      "description": "Local business website and Google readiness audit lead",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "hasWebsite": { "type": "boolean" },
        "websiteUrl": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "town": { "type": "string" },
        "recommendedSpecialty": { "type": "string" },
        "topIssues": { "type": "array" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "email",
        "name",
        "phone",
        "hasWebsite",
        "websiteUrl",
        "businessName",
        "businessType",
        "town",
        "recommendedSpecialty",
        "topIssues",
        "summary",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "site_settings/{settingsId}": {
      "schema": "SiteSettings",
      "description": "Global site configuration"
    },
    "content/{contentId}": {
      "schema": "Content",
      "description": "Section-specific content"
    },
    "subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter email list"
    },
    "audit_leads/{leadId}": {
      "schema": "AuditLead",
      "description": "Captured leads from the Free Local Website & Google Readiness Audit tool"
    }
  }
}
