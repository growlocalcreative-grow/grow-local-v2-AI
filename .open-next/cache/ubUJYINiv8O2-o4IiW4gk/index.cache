":{\"@type\":\"ContactPoint\",\"telephone\":\"916-869-4142\",\"contactType\":\"customer service\",\"email\":\"renee@growlocalcreative.com\",\"availableLanguage\":\"English\"}}f:T579,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do I need to already have a domain or hosting?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nope. If you don't have a domain yet, I'll walk you through getting one and getting it connected. If you already have a site somewhere, I can work with what's there.\"}},{\"@type\":\"Question\",\"name\":\"Do you work with nonprofits and churches, not just businesses?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. I work with small businesses, nonprofits, churches, and local makers across the Georgetown Divide and El Dorado & Placer Counties.\"}},{\"@type\":\"Question\",\"name\":\"What does the free website audit actually include?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"I'll look over your current site and send you a short video walking through 3 simple fixes that could help you get more calls or messages from it - no obligation.\"}},{\"@type\":\"Question\",\"name\":\"You mentioned using AI tools. What does that mean for my site?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"I use AI-assisted tools to build faster and keep costs down. I test every site myself before it goes live.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to sign a long contract?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No long contracts. We talk about what you need, I give you a straightforward price, and we go from there - neighbor to neighbor.\"}}]}2:[\"$\",\"html\",null,{\"lang\":\"en\",\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"\\n          :root {\\n            --primary: #648264;\\n            --primary-foreground: #F7F4ED;\\n            --secondary: #ccdbcc;\\n            --secondary-f