",\"meta\",\"16\",{\"name\":\"twitter:description\",\"content\":\"Fast websites, clear mobile menus, and Google presence for Foothill contractors, eateries, and specialty makers.\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/Grow Local Creative_Green.ico\"}],[\"$\",\"$L1f\",\"18\",{}]],\"error\":null,\"digest\":\"$undefined\"}\nc:\"$7:metadata\"\n20:I[8637,[\"305\",\"static/chunks/305-ebb4b6c34b9f6961.js\",\"385\",\"static/chunks/385-43f1ef4ee0e0f8ef.js\",\"657\",\"static/chunks/657-9599c41ba0bc50b5.js\",\"193\",\"static/chunks/193-0391f6b05ce5acec.js\",\"427\",\"static/chunks/427-0e33e11b67a0fefa.js\",\"238\",\"static/chunks/238-8731da9f2055e034.js\",\"974\",\"static/chunks/app/page-5eb4d299a33920e3.js\"],\"Hero\"]\n21:I[9264,[\"305\",\"static/chunks/305-ebb4b6c34b9f6961.js\",\"385\",\"static/chunks/385-43f1ef4ee0e0f8ef.js\",\"657\",\"static/chunks/657-9599c41ba0bc50b5.js\",\"193\",\"static/chunks/193-0391f6b05ce5acec.js\",\"427\",\"static/chunks/427-0e33e11b67a0fefa.js\",\"238\",\"static/chunks/238-8731da9f2055e034.js\",\"974\",\"static/chunks/app/page-5eb4d299a33920e3.js\"],\"Freebies\"]\n22:I[9169,[\"305\",\"static/chunks/305-ebb4b6c34b9f6961.js\",\"385\",\"static/chunks/385-43f1ef4ee0e0f8ef.js\",\"657\",\"static/chunks/657-9599c41ba0bc50b5.js\",\"193\",\"static/chunks/193-0391f6b05ce5acec.js\",\"427\",\"static/chunks/427-0e33e11b67a0fefa.js\",\"238\",\"static/chunks/238-8731da9f2055e034.js\",\"974\",\"static/chunks/app/page-5eb4d299a33920e3.js\"],\"Services\"]\n23:I[4344,[\"305\",\"static/chunks/305-ebb4b6c34b9f6961.js\",\"385\",\"static/chunks/385-43f1ef4ee0e0f8ef.js\",\"657\",\"static/chunks/657-9599c41ba0bc50b5.js\",\"193\",\"static/chunks/193-0391f6b05ce5acec.js\",\"427\",\"static/chunks/427-0e33e11b67a0fefa.js\",\"238\",\"static/chunks/238-8731da9f2055e034.js\",\"974\",\"static/chunks/app/page-5eb4d299a33920e3.js\"],\"Future\"]\n24:I[1072,[\"305\",\"static/chunks/305-ebb4b6c34b9f6961.js\",\"385\",\"static/chunks/385-43f1ef4ee0e0f8ef.js\",\"657\",\"static/chunks/657-9599c41ba0bc50b5.js\",\"193\",\"static/chunks/193-0391f6b05ce5acec.js\",\"427\",\"static/chunks/427-0e33e11b67a0fefa.js\",\"238\",\"static/chunks/238-8731da9f2055e034.js\",\"974\",\"static/chunks/app/page-5eb4d299a33920e3.js\"],\"About\"]\n3:[\"$\",\"main\",null,{\"className\":\"flex-grow\",\"children\":[[\"$\",\"$L20\",\"hero\",{\"data\":{\"eyebrow\":\"COOL · AUBURN · PLACERVILLE · EL DORADO & PLACER COUNTIES\",\"headline\":\"Turn More Local Searches Into\",\"headlineEmphasis\":\"Paying Customers\",\"subhead\":\"Fast, modern websites, clear mobile menus, and local search foundations built for Foothill contractors, specialty eateries, bakeries, and makers. Straightforward digital tools that make your phone ring, showcase your craft, and help neighbors find you.\",\"ctaLabel\":\"Book a Free 15-Min Chat\",\"backgroundColor\":\"#F7F4ED\",\"textColor\":\"#1A1A1A\",\"id\":\"hero\"}}],[\"$\",\"$L21\",\"freebies\",{\"data\":{\"eyebrow\":\"Zero-Risk Support\",\"heading\":\"Free Foothill Growth Resources\",\"subheading\":\"No pressure, no hard sell. Just honest, practical guidance from a neighbor to help your local business stand out and thrive.\",\"items\":[{\"title\":\"Free 3-Minute Video 'Leak' Audit\",\"description\":\"Send over your website or Google listing. I'll record a private 3-minute video showing 3 specific spots where you might be losing local customers to competitors.\",\"icon\":\"Search\",\"buttonText\":\"Request My Free Audit\",\"href\":\"mailto:growlocalcreative@gmail.com?subject=Free%203-Minute%20Website%20Audit&body=Hi%20Renee%2C%20I'd%20love%20a%20free%203-minute%20video%20audit%20of%20my%20business%20presence.%20My%20business%20name%20or%20website%20is%3A\"},{\"title\":\"Google Search & Mobile Readiness Check\",\"description\":\"Unsure if your Google Maps pin, hours, and mobile view are set up properly? I'll review your local presence and email you a simple checklist of quick wins you can implement right away.\",\"icon\":\"CheckCircle2\",\"buttonText\":\"Get My Readiness Check\",\"href\":\"mailto:growlocalcreative@gmail.com?subject=Google%20Readiness%20Check&body=Hi%20Renee%2C%20could%20you%20check%20my%20Google%20listing%20and%20tell%20me%20what%20quick%20improvements%20I%20should%20make%3F%20My%20business%20name%20is%3A\"}],\"backgroundColor\":\"#ccdbcc\",\"textColor\":\"#1A1A1A\",\"id\":\"freebies\"}}],[\"$\",\"$L22\",\"services\",{\"data\":{\"heading\":\"Simple Web Tools for Local Neighbors\",\"subheading\":\"No jargon, no enterprise price tag — just the basics done right, so your business, nonprofit, or passion project can be found online.\",\"items\":[{\"title\":\"The Local Landing Page\",\"icon\":\"Globe\",\"description\":\"A clean, fast page that tells people who you are and gets them to call you.\",\"badge\":\"POPULAR\"},{\"title\":\"Website Rescues\",\"icon\":\"LifeBuoy\",\"description\":\"If your current site is broken, outdated, or just plain embarrassing, I'll clean it up and get it working again.\"},{\"icon\":\"Search\",\"description\":\"Make sure local folks can actually find you when they search. I'll get your Google listing dialed in so you show up.\",\"title\":\"Google Business Profile Setup\"},{\"icon\":\"Smartphone\",\"description\":\"Let customers reach you or book time even when your shop is closed.\",\"title\":\"The 24/7 Intake Desk\"},{\"title\":\"Nonprofit & Community Pages\",\"description\":\"Churches, clubs, and local nonprofits get the same simple, honest approach — built to fit a volunteer budget.\",\"icon\":\"Heart\"},{\"icon\":\"Sparkles\",\"title\":\"AI-Assisted Builds, Transparently\",\"description\":\"I use AI tools to build faster and keep costs down, and I'm upfront about that. I test everything myself before you ever see it.\"}],\"backgroundColor\":\"#3D4337\",\"textColor\":\"#F7F4ED\",\"id\":\"services\"}}],[\"$\",\"$L23\",\"future\",{}],[\"$\",\"$L24\",\"about\",{\"data\":{\"badgeText\":\"Local Partner · Foothills Proud\",\"heading\":\"\\\"Hi, I'm your local digital growth partner.\\\"\",\"paragraphs\":[\"I live right here in Cool, CA, working with hard-working small business owners across the Georgetown Divide, Auburn, Placerville, and the Foothills. Whether you're running a trade crew, serving up comfort food at a local eatery or food truck, or crafting specialty goods, your business deserves a digital presence that actually drives revenue.\",\"Most agencies charge big-city prices and speak in confusing tech jargon. I don't. I take a practical, builder's approach: websites that load in a flash on spotty foothill cell connections, clear Google presence, and frictionless forms that send customer inquiries straight to your phone.\",\"I build custom, modern systems tailored to how rural and foothill businesses actually operate, whether that's an online menu for hungry weekenders, an instant quote form for home services, or getting your Google listing to reflect your real hours and location.\",\"Whether your current site is slow and outdated, or you're starting fresh, I'm right down the road to help you look great, build trust, and win more local business.\"],\"backgroundColor\":\"#FFFFFF\",\"textColor\":\"#1A1A1A\",\"id\":\"about\"}}],\"$L25\"]}]\n26:I[2258,[\"305\",\"static/chunks/305-ebb4b6c34b9f6961.js\",\"385\",\"static/chunks/385-43f1ef4ee0e0f8ef.js\",\"657\",\"static/chunks/657-9599c41ba0bc50b5.js\",\"193\",\"static/chunks/193-0391f6b05ce5acec.js\",\"427\",\"static/chunks/427-0e33e11b67a0fefa.js\",\"238\",\"static/chunks/238-8731da9f2055e034.js\",\"974\",\"static/chunks/app/page-5eb4d299a33920e3.js\"],\"FAQ\"]\n25:[\"$\",\"$L26\",\"faq\",{\"data\":{\"heading\":\"Common Questions\",\"subheading\":\"The stuff folks usually ask before reaching out.\",\"items\":[{\"question\":\"Do I need to already have a domain or hosting?\",\"answer\":\"Nope. If you don't have a domain yet, I'll walk you through getting one and getting it connected. If you already have a site somewhere, I can work with what's there.\"},{\"question\":\"Do you work with nonprofits and churches, not just businesses?\",\"answer\":\"Yes. I work with small businesses, nonprofits, churches, and local makers across the Georgetown Divide and El Dorado & Placer Counties.\"},{\"question\":\"What does the free website audit actually include?\",\"answer\":\"I'll look over your current site and send you a short video walking through 3 simple fixes that could help you get more calls or messages from it - no obligation.\"},{\"question\":\"You mentioned using AI tools. What does that mean for my site?\",\"answer\":\"I use AI-assisted tools to build faster and keep costs down. I test every site myself before it goes live.\"},{\"question\":\"Do I need to sign a long contract?\",\"answer\":\"No long contracts. We talk about what you need, I give you a straightforward price, and we go from there - neighbor to neighbor.\"}],\"backgroundColor\":\"#3D4337\",\"textColor\":\"#F7F4ED\",\"id\":\"faq\"}}]\n"}