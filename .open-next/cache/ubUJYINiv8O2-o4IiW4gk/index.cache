h-72 bg-secondary/10 rounded-full blur-3xl pointer-events-none\"></div><div class=\"relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\"><div class=\"lg:col-span-7 space-y-3\"><div class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-secondary/20 text-[#E7EBD8] border border-secondary/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-3.5 h-3.5 text-secondary\" aria-hidden=\"true\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg><span>Free Local Business Lead Magnet</span></div><h3 class=\"font-heading text-2xl sm:text-3xl font-bold text-primary-foreground tracking-tight leading-tight\">Let&#x27;s stay connected.</h3><p class=\"text-primary-foreground/80 text-sm sm:text-base leading-relaxed max-w-xl\">Every once in a while, I share a quick, jargon-free tip to help local businesses and non-profits run smoother online. No spam, ever.</p></div><div class=\"lg:col-span-5\"><form class=\"space-y-3\"><div class=\"flex flex-col sm:flex-row gap-2\"><input type=\"email\" data-slot=\"input\" class=\"border-input file:text-foreground focus-visible:border-ring aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 flex w-full border px-3 py-1 shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive h-12 rounded-xl bg-white text-stone-900 placeholder:text-stone-500 border-none focus-visible:ring-2 focus-visible:ring-secondary text-sm\" placeholder=\"Enter your email address...\" value=\"\"/><button type=\"submit\" tabindex=\"0\" data-slot=\"button\" class=\"group/button inline-flex items-center justify-center border border-transparent bg-clip-padding text-sm whitespace-nowrap outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 [a]:hover:bg-primary/80 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 h-12 px-6 rounded-xl bg-secondary hover:bg-secondary/90 text-secondary-foreground font-semibold shrink-0 gap-2 shadow-md transition-transform active:scale-95\"><span class=\"whitespace-nowrap\">Drop Me a Line</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-download w-4 h-4\" aria-hidden=\"true\"><path d=\"M12 15V3\"></path><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><path d=\"m7 10 5 5 5-5\"></path></svg></button></div><p class=\"text-xs text-primary-foreground/60 pl-1 flex items-center gap-1.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles w-3.5 h-3.5 text-secondary shrink-0\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg><span>Instant 1-page PDF · No spam · Practical Foothills advice only</span></p></form></div></div></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-12 mb-12\"><div class=\"space-y-4\"><div class=\"flex items-center gap-3\"><div class=\"h-14 w-14 overflow-hidden rounded-full border-2 border-secondary/20 bg-white p-1\"><img src=\"/logo.png\" alt=\"Grow Local Creative - Georgetown Divide Web Design &amp; SEO\" class=\"h-full w-full object-contain\" referrerPolicy=\"no-referrer\"/></div><span class=\"font-heading text-2xl font-semibold tracking-tight\">Grow Local Creative</span></div><p class=\"text-primary-foreground/80 max-w-xs leading-relaxed\">Your local digital helper for small businesses, nonprofits, and makers across the Georgetown Divide - cutting through the tech noise so life stays simpler.</p></div><div class=\"space-y-4\"><h3 class=\"font-heading text-xl font-medium\">Get in Touch</h3><ul class=\"space-y-3\"><li><a href=\"mailto:renee@growlocalcreative.com\" class=\"flex items-center gap-3 hover:text-secondary transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-5 w-5 text-secondary\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg><span>renee@growlocalcreative.com</span></a></li><li><a href=\"tel:9168694142\" class=\"flex items-center gap-3 hover:text-secondary transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone h-5 w-5 text-secondary\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><span>916-869-4142</span></a></li><li class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin h-5 w-5 text-secondary shrink-0 mt-1\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span class=\"text-primary-foreground/80\">Based in Cool, CA<!-- --> · Serving the Georgetown Divide, Northern Foothill Sierras, El Dorado &amp; Placer Counties.</span></li></ul></div><div class=\"space-y-4\"><h3 class=\"font-heading text-xl font-medium\">Follow Along</h3><div class=\"flex gap-4\"><a href=\"https://instagram.com/growlocalcreative\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"h-10 w-10 rounded-full border border-primary-foreground/20 flex items-center justify-center hover:bg-secondary hover:text-secondary-foreground transition-all\" aria-label=\"Instagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-instagram h-5 w-5\" aria-hidden=\"true\"><rect width=\"20\" height=\"20\" x=\"2\" y=\"2\" rx=\"5\" ry=\"5\"></rect><path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"></path><line x1=\"17.5\" x2=\"17.51\" y1=\"6.5\" y2=\"6.5\"></line></svg></a><a href=\"https://facebook.com/growlocalcreative\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"h-10 w-10 rounded-full border border-primary-foreground/