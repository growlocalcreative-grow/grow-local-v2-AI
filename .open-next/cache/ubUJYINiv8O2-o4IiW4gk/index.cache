oogletagmanager.com/gtag/js?id=G-JY9EM9G6JM\" as=\"script\"/><meta name=\"theme-color\" content=\"#648264\"/><title>Grow Local Creative | Web Design &amp; Local Growth for Foothill Businesses</title><meta name=\"description\" content=\"Fast websites, mobile menus, and local Google search foundations for Foothill contractors, eateries, specialty shops, and makers across El Dorado &amp; Placer Counties.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"Web Design Georgetown Divide,Contractor Websites Cool CA,Restaurant Mobile Menu Auburn CA,Small Business Website Cool CA,Google Business Profile Setup El Dorado County,Local Search Foothill Sierra,Placerville Web Design,Grow Local Creative\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://growlocalcreative.com\"/><meta name=\"google-site-verification\" content=\"7s9Nx1UeeBbX0Emq0X4v4U1Y6f-Z4-40L14\"/><meta property=\"og:title\" content=\"Grow Local Creative | Turn Local Searches into Paying Customers\"/><meta property=\"og:description\" content=\"Fast websites, clear mobile menus, and Google presence for Foothill contractors, eateries, and specialty makers.\"/><meta property=\"og:url\" content=\"https://growlocalcreative.com\"/><meta property=\"og:site_name\" content=\"Grow Local Creative\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Grow Local Creative | Turn Local Searches into Paying Customers\"/><meta name=\"twitter:description\" content=\"Fast websites, clear mobile menus, and Google presence for Foothill contractors, eateries, and specialty makers.\"/><link rel=\"icon\" href=\"/Grow Local Creative_Green.ico\"/><style>\n          :root {\n            --primary: #648264;\n            --primary-foreground: #F7F4ED;\n            --secondary: #ccdbcc;\n            --secondary-foreground: #3D4337;\n            --background: #F7F4ED;\n            --foreground: #1A1A1A;\n            --card: #FFFFFF;\n            --border: #E5E5E5;\n            --ring: #648264;\n          }\n        </style><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><script type=\"application/ld+json\" id=\"organization-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Grow Local Creative\",\"url\":\"https://growlocalcreative.com\",\"logo\":\"https://growlocalcreative.com/logo.png\",\"email\":\"renee@growlocalcreative.com\",\"telephone\":\"916-869-4142\",\"sameAs\":[\"https://instagram.com/growlocalcreative\",\"https://facebook.com/growlocalcreative\"]}</script><script type=\"application/ld+json\" id=\"website-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Grow Local Creative\",\"url\":\"https://growlocalcreative.com\",\"description\":\"Simple, phone-friendly websites for small businesses and nonprofits across the Georgetown Divide.\",\"publisher\":{\"@id\":\"https://growlocalcreative.com/#organization\"}}</script><script type=\"application/ld+json\" id=\"local-business-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"@id\":\"https://growlocalcreative.com/#organization\",\"name\":\"Grow Local Creative\",\"description\":\"Simple, phone-friendly websites and web tools for small businesses, nonprofits, churches, and makers across the Georgetown Divide and Northern Foothill Sierras.\",\"url\":\"https://growlocalcreative.com\",\"email\":\"renee@growlocalcreative.com\",\"telephone\":\"916-869-4142\",\"logo\":\"https://growlocalcreative.com/logo.png\",\"image\":\"https://growlocalcreative.com/logo.png\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Cool\",\"addressRegion\":\"CA\",\"addressCountry\":\"US\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":38.8924,\"longitude\":-121.0163},\"areaServed\":[{\"@type\":\"AdministrativeArea\",\"name\":\"El Dorado County, CA\"},{\"@type\":\"AdministrativeArea\",\"name\":\"Placer County, CA\"},{\"@type\":\"Place\",\"name\":\"Georgetown Divide\"},{\"@type\":\"Place\",\"name\":\"Northern Foothill Sierras\"},{\"@type\":\"Place\",\"name\":\"Cool, CA\"},{\"@type\":\"Place\",\"name\":\"Pilot Hill, CA\"},{\"@type\":\"Place\",\"name\":\"Georgetown, CA\"},{\"@type\":\"Place\",\"name\":\"Garden Valley, CA\"},{\"@type\":\"Place\",\"name\":\"Greenwood, CA\"}],\"knowsAbout\":[\"Web Design\",\"Local SEO\",\"Google Business Profile\",\"AI-Assisted Web Development\",\"Nonprofit Websites\"],\"openingHours\":\"Mo-Fr 09:00-17:00\",\"priceRange\":\"$\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"telephone\":\"916-869-4142\",\"contactType\":\"customer service\",\"email\":\"renee@growlocalcreative.com\",\"availableLanguage\":\"English\"}}</script><script type=\"application/ld+json\" id=\"faq-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do I need to already have a domain or hosting?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nope. If you don't have a domain yet, I'll walk you through getting one and getting it connected. If you already have a site somewhere, I can work with what's there.\"}},{\"@type\":\"Question\",\"name\":\"Do you work with nonprofits and churches, not just businesses?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. I work with small businesses, nonprofits, churches, and local makers across the Georgetown Divide and El Dorado & Placer Counties.\"}},{\"@type\":\"Question\",\"name\":\"What does the free website audit actually include?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"I'll look over your current site and send you a short video walking through 3 simple fixes that could help you get more calls or messages from it - no obligation.\"}},{\"@type\":\"Question\",\"name\":\"You mentioned using AI tools. What does that mean for my site?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"I use AI-assisted tools to build faster and keep costs down. I test every site myself before it goes live.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to sign a long contract?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No long contracts. We talk about what you need, I give you a straightforward price, and we go from there - neighbor to neighbor.\"}}]}</script><script type=\"application/ld+json\" id=\"services-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"serviceType\":\"Web Design and SEO for Local Businesses\",\"provider\":{\"@type\":\"ProfessionalService\",\"name\":\"Grow Local Creative\"},\"areaServed\":{\"@type\":\"State\",\"name\":\"California\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Web Services\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"The Local Landing Page\",\"description\":\"A clean, fast page that tells people who you are and gets them to call you.\"},\"position\":1},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Website Rescues\",\"description\":\"If your current site is broken, outdated, or just plain embarrassing, I'll clean it up and get it working again.\"},\"position\":2},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Google Business Profile Setup\",\"description\":\"Make sure local folks can actually find you when they search. I'll get your Google listing dialed in so you show up.\"},\"position\":3},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"The 24/7 Intake Desk\",\"description\":\"Let customers reach you or book time even when your shop is closed.\"},\"position\":4},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Nonprofit & Community Pages\",\"description\":\"Churches, clubs, and local nonprofits get the same simple, honest approach — built to fit a volunteer budget.\"},\"position\":5},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"AI-Assisted Builds, Transparently\",\"description\":\"I use AI tools to build faster and keep costs down, and I'm upfront about that. I test everything myself before you ever see it.\"},\"position\":6}]}}</script><script type=\"application/ld+json\" id=\"navigation-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"SiteNavigationElement\",\"position\":1,\"name\":\"About\",\"url\":\"https://growlocalcreative.com/#about\"},{\"@type\":\"SiteNavigationElement\",\"position\":2,\"name\":\"Services\",\"url\":\"https://growlocalcreative.com/#services\"},{\"@type\":\"SiteNavigationElement\",\"position\":3,\"name\":\"Free Tools\",\"url\":\"https://growlocalcreative.com/#freebies\"},{\"@type\":\"SiteNavigationElement\",\"position\":4,\"name\":\"FAQ\",\"url\":\"https://growlocalcreative.com/#faq\"}]}</script><script type=\"application/ld+json\" id=\"breadcrumb-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://growlocalcreative.com\"}]}</script><script type=\"application/ld+json\" id=\"speakable-schema\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\".font-heading\",\".hero-subhead\",\".section-heading\"]},\"url\":\"https://growlocalcreative.com\"}</script><div class=\"min-h-screen flex flex-col\"><header class=\"sticky top-0 z-50 w-full border-b bg-background/80 backdrop-blur-md\"><div class=\"container mx-auto flex h-16 items-center justify-between px-4\"><div class=\"flex items-center gap-3\" style=\"opacity:0;transform:translateX(-20px)\"><a class=\"flex items-center gap-3 group\" href=\"/\"><div class=\"relative h-12 w-12 overflow-hidden rounded-full border-2 border-primary/10 transition-transform group-hover:scale-105\"><img src=\"/logo.png\" alt=\"Grow Local Creative - Georgetown Divide Web Design &amp; SEO\" class=\"h-full w-full object-cover\" referrerPolicy=\"no-referrer\"/></div><span class=\"font-heading text-xl font-semibold tracking-tight hidden sm:block\">Grow Local Creative</span></a></div><nav class=\"hidden md:flex items-center gap-8\"><a class=\"text-sm font-medium transition-colors hover:text-primary text-muted-foreground\" href=\"/partners\">Our Work</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-muted-foreground\" href=\"#freebies\">Free Tools</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-muted-foreground\" href=\"#services\">Services</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-muted-foreground\" href=\"#upcoming\">Upcoming Tools</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-muted-foreground\" href=\"#about\">About</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-muted-foreground\" href=\"#faq\">FAQ</a><a class=\"text-sm font-medium transition-colors hover:text-primary text-muted-foreground/50 hover:text-primary flex items-center gap-1.5\" href=\"/admin\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock h-3.5 w-3.5\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>Admin Login</a><button type=\"button\" tabindex=\"0\" data-slot=\"button\" class=\"group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 bg-primary text-primary-foreground [a]:hover:bg-primary/80 h-7 gap-1 rounded-[min(var(--radius-md),12px)] px-2.5 text-[0.8rem] in-data-[slot=button-group]:rounded-lg has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-3.5\">Get in Touch</button></nav><div class=\"md:hidden\"><button type=\"button\" tabindex=\"0\" data-slot=\"button\" aria-haspopup=\"dialog\" aria-expanded=\"false\" data-state=\"closed\" class=\"group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-8\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-6 w-6\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main class=\"flex-grow\"><section class=\"relative overflow-hidden pt-20 pb-24 md:pt-32 md:pb-40\" style=\"background-color:#F7F4ED;color:#1A1A1A\"><div class=\"absolute top-0 right-0 -z-10 h-[500px] w-[500px] rounded-full bg-secondary/10 blur-3xl\"></div><div class=\"absolute bottom-0 left-0 -z-10 h-[400px] w-[400px] rounded-full bg-primary/5 blur-3xl\"></div><div class=\"container mx-auto px-4 text-center\"><div class=\"inline-flex items-center gap-2 rounded-full bg-secondary/20 px-4 py-1.5 text-sm font-medium text-primary mb-8\" style=\"opacity:0;transform:translateY(20px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin h-4 w-4\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span>COOL · AUBURN · PLACERVILLE · EL DORADO &amp; PLACER COUNTIES</span></div><h1 class=\"mx-auto max-w-4xl font-heading text-5xl md:text-7xl font-medium leading-[1.1] tracking-tight text-foreground mb-6\" style=\"opacity:0;transform:translateY(20px)\">Turn More Local Searches Into<!-- --> <span class=\"italic text-primary\">Paying Customers</span></h1><p class=\"mx-auto max-w-2xl text-lg md:text-xl text-muted-foreground leading-relaxed mb-10 hero-subhead\" style=\"opacity:0;transform:translateY(20px)\">Fast, modern websites, clear mobile menus, and local search foundations built for Foothill contractors, specialty eateries, bakeries, and makers. Straightforward digital tools that make your phone ring, showcase your craft, and help neighbors find you.</p><div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\" style=\"opacity:0;transform:translateY(20px)\"><button type=\"button\" tabindex=\"0\" data-slot=\"button\" class=\"group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 h-9 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 w-full sm:w-auto px-8 py-6 text-lg rounded-full\">Book a Free 15-Min Chat</button></div></div></section><section id=\"freebies\" class=\"py-24 scroll-mt-20\" style=\"background-color:#ccdbcc;color:#1A1A1A\"><div class=\"container mx-auto px-4\"><div class=\"text-center mb-16 space-y-4\"><div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-secondary/10 text-secondary text-xs font-bold tracking-widest uppercase\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-gift h-3.5 w-3.5\" aria-hidden=\"true\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"></rect><path d=\"M12 8v13\"></path><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"></path><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"></path></svg>Zero-Risk Support</div><h2 class=\"font-heading text-4xl md:text-5xl font-medium leading-tight\">Free Foothill Growth Resources</h2><p class=\"opacity-70 text-lg max-w-2xl mx-auto leading-relaxed\">No pressure, no hard sell. Just honest, practical guidance from a neighbor to help your local business stand out and thrive.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto\"><div class=\"group relative bg-white p-8 md:p-10 rounded-[2.5rem] border border-stone-100 shadow-sm hover:shadow-md transition-all hover:border-secondary/30 flex flex-col h-full\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"h-14 w-14 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-white transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search h-6 w-6\" aria-hidden=\"true\"><path d=\"m21 21-4.34-4.34\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle></svg></div><h3 class=\"font-heading text-2xl font-medium text-stone-900 mb-4\">Free 3-Minute Video &#x27;Leak&#x27; Audit</h3><p class=\"text-stone-500 leading-relaxed mb-8 flex-grow\">Send over your website or Google listing. I&#x27;ll record a private 3-minute video showing 3 specific spots where you might be losing local customers to competitors.</p><a href=\"mailto:growlocalcreative@gmail.com?subject=Free%203-Minute%20Website%20Audit&amp;body=Hi%20Renee%2C%20I&#x27;d%20love%20a%20free%203-minute%20video%20audit%20of%20my%20business%20presence.%20My%20business%20name%20or%20website%20is%3A\" class=\"inline-flex items-center justify-between w-full px-6 py-4 rounded-xl bg-stone-900 text-white font-medium hover:bg-secondary transition-colors group/btn\"><span>Request My Free Audit</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-5 w-5 group-hover/btn:translate-x-1 transition-transform\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"group relative bg-white p-8 md:p-10 rounded-[2.5rem] border border-stone-100 shadow-sm hover:shadow-md transition-all hover:border-secondary/30 flex flex-col h-full\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"h-14 w-14 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-white transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-6 w-6\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"font-heading text-2xl font-medium text-stone-900 mb-4\">Google Search &amp; Mobile Readiness Check</h3><p class=\"text-stone-500 leading-relaxed mb-8 flex-grow\">Unsure if your Google Maps pin, hours, and mobile view are set up properly? I&#x27;ll review your local presence and email you a simple checklist of quick wins you can implement right away.</p><a href=\"mailto:growlocalcreative@gmail.com?subject=Google%20Readiness%20Check&amp;body=Hi%20Renee%2C%20could%20you%20check%20my%20Google%20listing%20and%20tell%20me%20what%20quick%20improvements%20I%20should%20make%3F%20My%20business%20name%20is%3A\" class=\"inline-flex items-center justify-between w-full px-6 py-4 rounded-xl bg-stone-900 text-white font-medium hover:bg-secondary transition-colors group/btn\"><span>Get My Readiness Check</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-5 w-5 group-hover/btn:translate-x-1 transition-transform\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><sectio