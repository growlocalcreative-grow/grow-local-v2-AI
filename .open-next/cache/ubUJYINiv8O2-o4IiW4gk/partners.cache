st everything myself before you ever see it.\"},\"position\":6}]}}12:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"services-schema\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1a\"}}]\n13:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"navigation-schema\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"ItemList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"SiteNavigationElement\\\",\\\"position\\\":1,\\\"name\\\":\\\"About\\\",\\\"url\\\":\\\"https://growlocalcreative.com/#about\\\"},{\\\"@type\\\":\\\"SiteNavigationElement\\\",\\\"position\\\":2,\\\"name\\\":\\\"Services\\\",\\\"url\\\":\\\"https://growlocalcreative.com/#services\\\"},{\\\"@type\\\":\\\"SiteNavigationElement\\\",\\\"position\\\":3,\\\"name\\\":\\\"Free Tools\\\",\\\"url\\\":\\\"https://growlocalcreative.com/#freebies\\\"},{\\\"@type\\\":\\\"SiteNavigationElement\\\",\\\"position\\\":4,\\\"name\\\":\\\"FAQ\\\",\\\"url\\\":\\\"https://growlocalcreative.com/#faq\\\"}]}\"}}]\n14:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"breadcrumb-schema\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://growlocalcreative.com\\\"}]}\"}}]\n15:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"speakable-schema\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"speakable\\\":{\\\"@type\\\":\\\"SpeakableSpecification\\\",\\\"cssSelector\\\":[\\\".font-heading\\\",\\\".hero-subhead\\\",\\\".section-heading\\\"]},\\\"url\\\":\\\"https://growlocalcreative.com\\\"}\"}}]\n16:[\"$\",\"$L1b\",null,{\"src\":\"https://www.googletagmanager.com/gtag/js?id=G-JY9EM9G6JM\",\"strategy\":\"afterInteractive\"}]\n17:[\"$\",\"$L1b\",null,{\"id\":\"ga-init\",\"strategy\":\"afterInteractive\",\"children\":\"\\n            window.dataLayer = window.dataLayer || [];\\n            function gtag(){dataLayer.push(arguments);}\\n            gtag('js', new Date());\\n            gtag('config', 'G-JY9EM9G6JM');\\n          \"}]\n18:[\"$\",\"$L1c\",null,{}]\n19:[\"$\",\"$L1d\",null,{\"settings\":{\"agencyName\":\"Grow Local Creative\",\"email\":\"renee@growlocalcreative.com\",\"phone\":\"916-869-4142\",\"location\":\"Based in Cool, CA\",\"primaryColor\":\"#648264\",\"primaryForeground\":\"#F7F4ED\",\"secondaryColor\":\"#ccdbcc\",\"secondaryForeground\":\"#3D4337\",\"backgroundColor\":\"#F7F4ED\",\"foregroundColor\":\"#1A1A1A\",\"cardColor\":\"#FFFFFF\",\"borderColor\":\"#E5E5E5\",\"footerDescription\":\"Your local digital helper for small businesses, nonprofits, and makers across the Georgetown Divide - cutting through the tech noise so life stays simpler.\",\"socialLinks\":[{\"isEnabled\":true,\"url\":\"https://instagram.com/growlocalcreative\",\"platform\":\"Instagram\"},{\"isEnabled\":true,\"url\":\"https://facebook.com/growlocalcreative\",\"platform\":\"Facebook\"},{\"url\":\"https://linkedin.com/company/growlocalcreative\",\"platform\":\"Linkedin\",\"isEnabled\":false}],\"sectionOrder\":[\"hero\",\"freebies\",\"services\",\"future\",\"about\",\"faq\"],\"hiddenSections\":[],\"newsletter\":{\"cta\":\"Drop Me a Line\",\"title\":\"Let's stay connected.\",\"isEnabled\":true,\"description\":\"Every once in a while, I share a quick, jargon-free tip to help local businesses and non-profits run smoother online. No spam, ever.\",\"successMessage\":\"Thanks for joining! Keep an eye on your inbox for neighborly updates.\"},\"id\":\"global\"},\"children\":[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$