Creative\"}],[\"$\",\"meta\",\"4\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"5\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"link\",\"6\",{\"rel\":\"canonical\",\"href\":\"https://growlocalcreative.com/partners\"}],[\"$\",\"meta\",\"7\",{\"name\":\"google-site-verification\",\"content\":\"7s9Nx1UeeBbX0Emq0X4v4U1Y6f-Z4-40L14\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:title\",\"content\":\"Our Work & Local Partners | Grow Local Creative\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:description\",\"content\":\"Real local websites built for Foothill contractors, smokehouses, and community groups. Fast, mobile-first, and designed to turn clicks into phone calls.\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:url\",\"content\":\"https://growlocalcreative.com/partners\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:site_name\",\"content\":\"Grow Local Creative\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"Our Work & Local Partners | Grow Local Creative\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"Real local websites built for Foothill contractors, smokehouses, and community groups. Fast, mobile-first, and designed to turn clicks into phone calls.\"}],[\"$\",\"link\",\"16\",{\"rel\":\"icon\",\"href\":\"/Grow Local Creative_Green.ico\"}],[\"$\",\"$L1f\",\"17\",{}]],\"error\":null,\"digest\":\"$undefined\"}\ne:\"$9:metadata\"\n20:Td49,{\"@context\":\"https://schema.org\",\"@type\":\"CollectionPage\",\"name\":\"Our Work & Local Partners | Grow Local Creative\",\"description\":\"Showcase of local websites and digital tools built for Georgetown Divide and Foothill businesses, contractors, and nonprofits.\",\"url\":\"https://growlocalcreative.com/partners\",\"mainEntity\":{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@type\":\"CreativeWork\",\"name\":\"Fix It Cool\",\"url\":\"https://www.fixitcool.com\",\"headline\":\"Turning urgent home repair searches into immediate phone calls.\",\"description\":\"Designed for immediate mobile action. Built to load in under a second on spotty Sierra cell reception, featuring prominent one-tap calling, clear repair service categories, and verified local Foothills service radiuses.\",\"creator\":{\"@type\":\"LocalBusiness\",\"name\":\"Grow Local Creative\",\"telephone\":\"916-869-4142\",\"email\":\"renee@growlocalcreative.com\"}}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@type\":\"CreativeWork\",\"name\":\"ALT Business Connections\",\"url\":\"https://www.altbusinessconnections.org\",\"headline\":\"Keeping local commerce and connection circulating right here on the Divide.\",\"description\":\"A welcoming, modern community hub that spotlights homegrown Divide businesses. Features an accessible directory, upcoming breakfast and mixer schedules, and straightforward membership paths to strengthen regional commerce.\",\"creator\":{\"@type\":\"LocalBusiness\",\"name\":\"Grow Local Creative\",\"telephone\":\"916-869-4142\",\"email\":\"renee@growlocalcreative.com\"}}},{\"@type\":\"ListItem\",\"position\":3,\"item\":{\"@type\":\"CreativeWork\",\"name\":\"Divide Women's Club\",\"url\":\"https://www.dividewomensclub.org\",\"headline\":\"Decades of community giving, youth scholarships, and volunteer events made modern.\",\"description\":\"Serving our mountain towns for generations, the Divide Women's Club now has an elegant, high-accessibility web presence. Local students and parents can easily apply for scholarships, and neighbors can stay informed on seasonal fundraisers.\",\"creator\":{\"@type\":\"LocalBusiness\",\"name\":\"Grow Local Creative\",\"telephone\":\"916-869-4142\",\"email\":\"renee@growlocalcreative.com\"}}},{\"@type\":\"ListItem\",\"position\":4,\"item\":{\"@type\":\"CreativeWork\",\"name\":\"Pig-Sure Perfect BBQ\",\"url\":\"https://pig-sure-perfect-bbq.growlocalcreative.workers.dev/\",\"headline\":\"Mouth-watering mobile menu & catering booking engine designed to pack the pit.\",\"description\":\"Nothing loses a customer faster than an unreadable PDF menu on a phone. For Pig-Sure Perfect BBQ, we designed an ultra-fast digital menu, real-time pop-up schedule, and instant catering quote pipeline that lets locals book authentic slow-smoked meats in seconds.\",\"creator\":{\"@type\":\"LocalBusiness\",\"name\":\"Grow Local Creative\",\"telephone\":\"916-869-4142\",\"email\":\"renee@growlocalcreative.com\"}}},{\"@type\":\"ListItem\",\"position\":5,\"item\":{\"@type\":\"CreativeWork\",\"name\":\"Cool Charity\",\"url\":\"https://www.coolcharity.org\",\"headline\":\"Direct, transparent grassroots aid when our foothill neighbors need it most.\",\"description\":\"Hyper-local mutual aid runs on radical transparency. Cool Charity is being built to connect Foothill neighbors directly to relief drives, emergency storm aid, and volunteer support with zero overhead and zero corporate middleman.\",\"creator\":{\"@type\":\"LocalBusiness\",\"name\":\"Grow Local Creative\",\"telephone\":\"916-869-4142\",\"email\":\"renee@growlocalcreative.com\"}}}]}}5:[[\"$\",\"$L1b\",null,{\"id\":\"partners-jsonld\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$20\"}}],\"$L21\"]\n22:I[6567,[\"305\",\"static/chunks/305-ebb4b6c34b9f6961.js\",\"385\",\"static/chunks/385-43f1ef4ee0e0f8ef.js\",\"692\",\"static/chunks/692-cdfd34056585b4d4.js\",\"284\",\"static/chunks/app/partners/page-c08fe536db51d163.js\"],\"PartnersClient\"]\n21:[\"$\",\"main\",null,{\"className\":\"flex-grow\",\"children\":[\"$\",\"$L22\",null,{\"content\":{\"eyebrow\":\"OUR WORK & LOCAL PARTNERSHIPS\",\"headline\":\"Real Local Work.\",\"headlineEmphasis\":\"Real Community Impact.\",\"subhead\":\"Take a look at the websites, mobile menus, and digital tools we've built right here in the Georgetown Divide and Foothills. From local contractors and business alliances to smokehouse menus and community charities - fast, honest, and built to turn interest into action.\",\"bannerTitle\":\"Why We Build for Local Groups & Community Neighbors\",\"bannerDescription\":\"When our neighbors thrive, the entire Georgetown Divide thrives. We build high-performance web systems for community clubs, local charities, and trade businesses alike because every local enterprise deserves a modern, lightning-fast digital storefront without corporate price tags, tech jargon, or monthly hostage fees.\",\"ctaTitle\":\"Ready for a Website That Actually Rings Your Phone?\",\"ctaDescription\":\"Whether you're a contractor looking to lock in high-margin jobs, a local bakery needing a menu folks can actually read, or a service business ready to get found on Google—let's build your 24/7 digital storefront.\",\"ctaButtonText\":\"Book a Free 15-Minute Local Growth Chat\",\"projects\":[{\"id\":\"fixitcool\",\"name\":\"Fix It Cool\",\"url\":\"https://www.fixitcool.com\",\"displayUrl\":\"www.fixitcool.com\",\"status\":\"live\",\"statusLabel\":\"Live Website\",\"category\":\"Contractors & Home Repairs\",\"tagline\":\"Turning urgent home repair searches into immediate phone calls.\",\"problemSolved\":\"Homeowners in Cool and the Divide needed a fast way to find reliable local help without wading through corporate directories or non-responsive forms.\",\"description\":\"Designed for immediate mobile action. Built to load in under a second on spotty Sierra cell reception, featuring prominent one-tap calling, clear repair service categories, and verified local Foothills service radiuses.\",\"features\":[\"One-tap emergency call & text buttons in header\",\"Sub-second load times on rural 3G/LTE connections\",\"Focused service areas covering Cool, ALT & the Divide\",\"Clear upfront repair lists (carpentry, decks, plumbing, maintenance)\"],\"metrics\":[{\"label\":\"Mobile Speed\",\"value\":\"< 0.8s\"},{\"label\":\"Conversion Focus\",\"value\":\"Direct Call\"},{\"label\":\"Target Area\",\"value\":\"Georgetown Divide\"}],\"accentColor\":\"#2F5233\",\"seed\":\"fixitcool\",\"gradient\":\"from-emerald-950 via-slate-900 to-emerald-900\"},{\"id\":\"alt-business\",\"name\":\"ALT Business Connections\",\"url\":\"https://www.altbusinessconnections.org\",\"displayUrl\":\"www.altbusinessconnections.org\",\"status\":\"live\",\"statusLabel\":\"Live Website\",\"category\":\"Business Alliance & Networking\",\"tagline\":\"Keeping local commerce and connection circulating right here on the Divide.\",\"problemSolved\":\"Local entrepreneurs needed a centralized digital home to showcase verified local merchants and drive attendance to monthly networking breakfasts.\",\"description\":\"A welcoming, modern community hub that spotlights homegrown Divide businesses. Features an accessible directory, upcoming breakfast and mixer schedules, and straightforward membership paths to strengthen regional commerce.\",\"features\":[\"Searchable local merchant & trade professional directory\",\"Monthly breakfast meeting announcements & RSVPs\",\"Community-first branding celebrating Divide business owners\",\"Frictionless updates without complex maintenance overhead\"],\"metrics\":[{\"label\":\"Community Reach\",\"value\":\"Georgetown Divide\"},{\"label\":\"Member Hub\",\"value\":\"Directory & Events\"},{\"label\":\"Design Style\",\"value\":\"Warm Foothill\"}],\"accentColor\":\"#B46524\",\"seed\":\"altbusiness\",\"gradient\":\"from-amber-950 via-stone-900 to-amber-900\"},{\"id\":\"divide-womens-club\",\"name\":\"Divide Women's Club\",\"url\":\"https://www.dividewomensclub.org\",\"displayUrl\":\"www.dividewomensclub.org\",\"status\":\"live\",\"statusLabel\":\"Live Website\",\"category\":\"Community & Historic Nonprofit\",\"tagline\":\"Decades of community giving, youth scholarships, and volunteer events made modern.\",\"problemSolved\":\"A historic community anchor needed to modernize their outreach, simplify student scholarship applications, and boost turnout for community charity events.\",\"description\":\"Serving our mountain towns for generations, the Divide Women's Club now has an elegant, high-accessibility web presence. Local students and parents can easily apply for scholarships, and neighbors can stay informed on seasonal fundraisers.\",\"features\":[\"Digital scholarship application downloads & deadline alerts\",\"Seasonal event calendars (craft faires, bake sales, teas)\",\"High-contrast, large-print mobile friendly typography\",\"Tribute to decades of Foothill community heritage and service\"],\"metrics\":[{\"label\":\"Impact\",\"value\":\"Annual Scholarships\"},{\"label\":\"Community\",\"value\":\"Divide Towns\"},{\"label\":\"Format\",\"value\":\"Accessible & Clean\"}],\"accentColor\":\"#4B5542\",\"seed\":\"dividewomen\",\"gradient\":\"from-stone-950 via-zinc-900 to-emerald-950\"},{\"id\":\"pigsure-bbq\",\"name\":\"Pig-Sure Perfect BBQ\",\"url\":\"https://pig-sure-perfect-bbq.growlocalcreative.workers.dev/\",\"displayUrl\":\"pig-sure-perfect-bbq.workers.dev\",\"status\":\"in-progress\",\"statusLabel\":\"In The Workshop\",\"category\":\"Artisanal Eatery & Catering\",\"tagline\":\"Mouth-watering mobile menu & catering booking engine designed to pack the pit.\",\"problemSolved\":\"Hungry customers abandoning slow, pinch-and-zoom PDF menus while trying to find weekend smokehouse pop-up locations.\",\"description\":\"Nothing loses a customer faster than an unreadable PDF menu on a phone. For Pig-Sure Perfect BBQ, we designed an ultra-fast digital menu, real-time pop-up schedule, and instant catering quote pipeline that lets locals book authentic slow-smoked meats in seconds.\",\"features\":[\"Zero-PDF mobile menu with vivid meats & sides breakdowns\",\"Automated event catering quote request form with guest-count slider\",\"Pop-up location tracker for weekend smoke sessions\",\"Edge-deployed on Cloudflare Workers for instant 50ms load times\"],\"metrics\":[{\"label\":\"Menu Load\",\"value\":\"< 300ms\"},{\"label\":\"Hosting\",\"value\":\"Cloudflare Edge\"},{\"label\":\"Conversion\",\"value\":\"Catering Bookings\"}],\"accentColor\":\"#8B2E15\",\"seed\":\"pigsurebbq\",\"gradient\":\"from-red-950 via-stone-900 to-amber-950\"},{\"id\":\"cool-charity\",\"name\":\"Cool Charity\",\"url\":\"https://www.coolcharity.org\",\"displayUrl\":\"www.coolcharity.org\",\"status\":\"in-progress\",\"statusLabel\":\"In The Workshop\",\"category\":\"Grassroots Relief & Giving\",\"tagline\":\"Direct, transparent grassroots aid when our foothill neighbors need it most.\",\"problemSolved\":\"Traditional charity portals feel impersonal and take heavy administrative cuts. Cool Charity needed a direct, local platform focused on trust and direct neighbor aid.\",\"description\":\"Hyper-local mutual aid runs on radical transparency. Cool Charity is being built to connect Foothill neighbors directly to relief drives, emergency storm aid, and volunteer support with zero overhead and zero corporate middleman.\",\"features\":[\"Transparent project-by-project community donation trackers\",\"Volunteer shift & skill coordination board\",\"Winter weather & rural emergency relief resource hub\",\"100% focused on Cool and surrounding foothill communities\"],\"metrics\":[{\"label\":\"Transparency\",\"value\":\"100% Local\"},{\"label\":\"Focus\",\"value\":\"Community Aid\"},{\"label\":\"Structure\",\"value\":\"Grassroots\"}],\"accentColor\":\"#2A4D69\",\"seed\":\"coolcharity\",\"gradient\":\"from-sky-950 via-slate-900 to-teal-950\"}],\"id\":\"partners\"},\"phone\":\"916-869-4142\"}]}]\n"}